# ──────────────────────────────────────────────────────────────────────────────
#  Benchmark configuration — copy to .env and adjust
# ──────────────────────────────────────────────────────────────────────────────

# Model identifiers
MODEL_NAME=mistralai/Mistral-7B-v0.1   # HF repo id or local folder name
GGUF_MODEL=mistral-7b-q4_k_m.gguf     # filename inside ./models/ for llama.cpp

# GPU config
N_GPU_LAYERS=99          # layers offloaded to GPU for llama.cpp (99 = all)
TENSOR_PARALLEL=1        # number of GPUs for vLLM tensor parallelism
DTYPE=auto               # float16 | bfloat16 | auto

# Inference config
CTX_SIZE=4096            # max context length
N_PARALLEL=4             # parallel sequences (llama.cpp / Ollama)

# Benchmark parameters
CONCURRENCY=1,4,8        # comma-separated concurrency levels to test
NUM_TOKENS=256           # max tokens to generate per request
WARMUP_REQUESTS=3        # warm-up requests before measurement
